<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', {title: head_title}) %>
</head>
<body>
    
    <aside id="offcanvas">
        <%- include('partials/offcanvas') %>
    </aside>

    <header id="top">
        <%- include('partials/header') %>
    </header>


    <main id="contacto">
        
        <h1>Contacto</h1>

        <section>

            <div>
                <h2>Nuestra dirección</h2>
                <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Nam placeat praesentium quo assumenda, facilis ex! Maxime nulla nobis iusto provident.</p>
            </div>

            <div>
                <h2>Envianos un mensaje</h2>
                <form action="#">
                    <div>
                        <label for="nombre">Nombre: </label>
                        <input type="text" id="nombre" name="nomnbre">
                    </div>
    
                    <div>
                        <label for="email">Email: </label>
                        <input type="email" id="email" name="email">
                    </div>
                    <div>
                        <label for="mensaje">Mensaje: </label>
                        <textarea id="mensaje" name="mensaje"></textarea>
                    </div>
                    <div>
                        <label for="aceptacion">
                            <input type="checkbox" id="aceptacion" name="aceptacion" required>
                            Acepto la <a href="#">politica de privacidad</a>    
                        </label>
                    </div>
                    <div>
                        <input class="button" type="submit" value="Enviar">
                    </div>
    
                </form>
            </div>

            
        </section>
    </main>

    <footer>
        <%- include('partials/footer') %>
    </footer>

    <script src="javascripts/front.js"></script>
</body>
</html>